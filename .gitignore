# Operating-system and editor clutter
.DS_Store
Thumbs.db
desktop.ini

# R session files
.Rhistory
.RData
.Ruserdata
.Rproj.user/
Rplots.pdf

# The Scopus API key belongs in ~/.Renviron, never in the repository
.Renviron

# Python
__pycache__/
*.pyc
.venv/

# Node dependencies are restored from mindmap/source/package-lock.json with
# npm ci, so the installed copy is never tracked.
node_modules/

# Local Claude Code state
.claude/worktrees/
.claude/settings.local.json

# Quarto's undated outputs, renamed by preregistration/_rename-output.R
preregistration/preregistration.pdf
preregistration/preregistration.html
preregistration/preregistration.tex

# The count script's deliverables derive from the data controller's export and
# are deposited elsewhere, never committed here
lets_story_summary_data_for_oxford.csv
lets_story_manifest_for_oxford.html

# The story-text delivery as received, with the data controller's viewer, and the
# extraction's working outputs stay on the local disk. The texts are published,
# compressed, in preregistration/story_texts/data/.
preregistration/Oxford-40k-stories/
preregistration/story_texts/data/**/*.tmp

# The count script's test scenarios write a synthetic export into a folder each
preregistration/count_script/tests/v2_*/
preregistration/count_script/tests/v3_*/
